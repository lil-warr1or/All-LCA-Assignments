import pandas as pd

# Create sample dataset
data = {
    'Name': ['Amit', 'Riya', 'Rahul', 'Sneha', 'Amit'],
    'Marks': [85, 90, None, 78, 85],
    'City': ['Mumbai', 'Pune', 'Delhi', None, 'Mumbai'],
    'Age': [18, 19, 18, 20, 18]
}

df = pd.DataFrame(data)

# Display original dataset
print("Original Dataset:")
print(df)

# Explore dataset
print("\nFirst Five Rows:")
print(df.head())

print("\nDataset Information:")
df.info()

print("\nStatistical Summary:")
print(df.describe())

# Check missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Handle missing values
df['Marks'] = df['Marks'].fillna(df['Marks'].mean())
df['City'] = df['City'].fillna('Unknown')

print("\nAfter Handling Missing Values:")
print(df)

# Identify duplicate records
print("\nDuplicate Records:")
print(df[df.duplicated()])

# Remove duplicate records
df = df.drop_duplicates()

print("\nAfter Removing Duplicates:")
print(df)

# Remove irrelevant column
df = df.drop(columns=['Age'])

print("\nAfter Removing Irrelevant Column:")
print(df)

# Select students scoring more than 80
result = df.loc[df['Marks'] > 80]

print("\nStudents Scoring More Than 80:")
print(result)

# Save cleaned dataset
df.to_csv('cleaned_students.csv', index=False)

print("\nCleaned dataset saved successfully!")
