
import numpy as np

# Create two matrices
A = np.array([[1, 2, 3],
              [4, 5, 6]])

B = np.array([[7, 8, 9],
              [10, 11, 12]])

# Display the matrices
print("First Matrix:")
print(A)

print("Second Matrix:")
print(B)

# Add the two matrices
C = A + B

# Display the result
print("Addition of Two Matrices:")
print(C)

